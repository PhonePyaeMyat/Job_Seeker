# Copy to .env.local and fill in your Firebase project values.
# Never commit .env.local, .env, or any service-account JSON.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Backend API base URL (Firebase Functions). Defaults to the deployed
# us-central1 URL for project job-seeker-80fd8 when unset. For local
# development against the emulator, use:
# REACT_APP_API_URL=http://127.0.0.1:5001/job-seeker-80fd8/us-central1/api
REACT_APP_API_URL=https://us-central1-job-seeker-80fd8.cloudfunctions.net/api
