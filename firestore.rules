rules_version = '2';

// Firestore security rules — Phase 2.
// Phase 1 tightened these to owner-or-admin writes. Phase 2 adds one more
// guard: only an admin may change a company's `verified` flag, so an
// employer cannot verify their own company. Application status changes are
// already restricted here to the job's poster or an admin, and to the
// `status` field only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || request.auth.token.email == 'admin@jobseeker.com'
      );
    }

    match /users/{userId} {
      // Anyone can read a user profile (public profiles), but only the owner
      // or an admin can write one. Admin promotion goes through the admin
      // panel, which checks isAdmin() — not through a client-set field.
      allow read: if true;
      allow create, update, delete: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /jobs/{jobId} {
      // Anyone can read active jobs. Inactive jobs (not yet approved, or
      // expired) are visible only to the poster and admins.
      allow read: if resource.data.active == true
        || (isSignedIn() && resource.data.postedBy == request.auth.uid)
        || isAdmin();

      // Only an employer or admin may create a job, and the server stamps
      // postedBy — the client cannot claim another user as poster.
      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer'
        && request.resource.data.postedBy == request.auth.uid
        || isAdmin();
      // Owner can update most fields but not `applicants` (apply flow owns it)
      // and not `postedBy`. Admins can update anything.
      allow update: if isSignedIn()
        && resource.data.postedBy == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['applicants', 'postedBy'])
        || isAdmin();
      // Applicants array may only be touched by the apply flow (API), so
      // only the owner/admin may write a job with a changed applicants list.
      allow update: if isSignedIn()
        && resource.data.postedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicants'])
        && request.resource.data.applicants.hasAll(resource.data.applicants)
        || isAdmin();

      allow delete: if isSignedIn()
        && (resource.data.postedBy == request.auth.uid || isAdmin());
    }

    match /applications/{applicationId} {
      // Job posters can read applications to their jobs, and the applicant
      // can read their own. Firestore rules cannot query other collections,
      // so ownership of the job is checked in the API (GET
      // /jobs/:id/applications) rather than here.
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      // Only the job poster or an admin may change the status, and only the
      // status field may change. The API enforces the same check; the rule
      // is the backstop.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid
          || isAdmin());
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow create: if isAdmin();
      // The owner may edit their company, but only an admin may change the
      // `verified` flag — otherwise an employer could verify themselves.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']);
      allow update: if isAdmin();
      allow delete: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
